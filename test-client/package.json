{
  "name": "consent-sdk-test-client",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "typecheck": "tsc --noEmit",
    "build:sdk": "npm --prefix .. run build",
    "start:lib": "npm run build:sdk && cross-env USE_BUILT_LIB=1 react-native start --reset-cache",
    "ios:lib": "npm run build:sdk && cross-env USE_BUILT_LIB=1 react-native run-ios",
    "android:lib": "npm run build:sdk && cross-env USE_BUILT_LIB=1 react-native run-android"
  },
  "dependencies": {
    "@datagrail/react-native-consent": "file:..",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-get-random-values": "^1.11.0",
    "react-native-mmkv": "^3.0.0",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-screens": "^3.29.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@react-native-community/cli": "^15.0.0",
    "@react-native-community/cli-platform-android": "^15.0.0",
    "@react-native-community/cli-platform-ios": "^15.0.0",
    "@react-native/babel-preset": "^0.76.0",
    "@react-native/metro-config": "^0.87.0",
    "@types/react": "^18.2.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0"
  }
}
