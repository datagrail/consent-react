{
  "name": "@datagrail/react-native-consent",
  "version": "0.1.0-alpha.1",
  "description": "DataGrail Consent SDK for React Native — privacy consent management with synchronous reads",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "expo-plugin",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "*.podspec",
    "!lib/typescript/test-client"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "consent",
    "privacy",
    "gdpr",
    "ccpa",
    "datagrail"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datagrail/react-native-consent.git"
  },
  "author": "DataGrail <engineering@datagrail.io>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/datagrail/react-native-consent/issues"
  },
  "homepage": "https://github.com/datagrail/react-native-consent#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.76.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.76.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-builder-bob": "^0.23.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "dependencies": {
    "react-native-mmkv": "^3.0.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/",
      "<rootDir>/test-client/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-mmkv)/)"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
